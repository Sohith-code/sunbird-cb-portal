{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowJs": true,
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
