{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "project",
  "projects": {
    "fusion": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ws",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "i18n": {
            "sourceLocale": "en-US",
            "locales": {
              "nb": "messages.nb.xlf"
            }
          },
          "options": {
            "outputPath": {
              "base": "dist/www/fusion"
            },
            "index": "src/index.html",
            "polyfills": [
              "src/polyfills.ts"
            ],
            "tsConfig": "tsconfig.app.json",
            "preserveSymlinks": true,
            "assets": [
              "src/favicon.ico",
              "src/favicon.png",
              "src/dashboard-assets/",
              "src/fusion-assets/",
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "/assets/pdfjs/"
              },
              "src/manifest.json"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles",
                "node_modules/@sunbird-cb/design-system/src/tokens"
              ]
            },
            "styles": [
              {
                "input": "node_modules/@sunbird-cb/design-system/src/tokens/foundations/_tokens.scss",
                "bundleName": "design-tokens"
              },
              {
                "input": "node_modules/@sunbird-cb/design-system/src/tokens/_index.scss",
                "bundleName": "design-utilities"
              },
              {
                "input": "src/styles/libraries.scss",
                "bundleName": "libraries"
              },
              "node_modules/material-icons/iconfont/material-icons.scss",
              "src/styles/mat-typography.scss",
              "src/styles/styles.scss",
              "node_modules/shepherd.js/dist/css/shepherd.css",
              {
                "inject": true,
                "input": "src/themes/theme-igot.scss",
                "bundleName": "theme-igot"
              },
              "node_modules/pdfjs-dist/web/pdf_viewer.css",
              "node_modules/igot-cb-tour-guide/scss/guided-tour-base-theme.scss",
              "node_modules/@ctrl/ngx-emoji-mart/picker.css",
              "node_modules/ckeditor5/dist/ckeditor5.css"
            ],
            "scripts": [
              "node_modules/shepherd.js/dist/js/shepherd.min.js",
              "src/js/smartechclient.js"
            ],
            "aot": true,
            "extractLicenses": false,
            "sourceMap": true,
            "optimization": false,
            "namedChunks": false,
            "allowedCommonJsDependencies": [
              "@ckeditor/ckeditor5-editor-classic"
            ],
            "browser": "src/main.ts"
          },
          "configurations": {
            "nb": {
              "budgets": [
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ]
            },
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "40mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "np": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.np.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4mb",
                  "maximumError": "15mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "dev": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "40mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "preprod": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.preprod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "40mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            },
            "benchmark": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.bm.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "40mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "serviceWorker": "ngsw-config.json"
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "port": 3000,
            "buildTarget": "fusion:build",
            "prebundle": {
              "exclude": ["@sunbird-cb/design-system", "@sunbird-cb/consumption"]
            }
          },
          "configurations": {
            "production": {
              "buildTarget": "fusion:build:production"
            },
            "nb": {
              "buildTarget": "fusion:build:nb"
            },
            "de": {
              "buildTarget": "fusion:build:de"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "fusion:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": [
              "src/favicon.ico",
              "src/fusion-assets"
            ],
            "styles": [
              "src/styles.scss"
            ],
            "scripts": []
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js",
            "devServerTarget": "fusion:serve"
          },
          "configurations": {
            "production": {
              "devServerTarget": "fusion:serve:production"
            }
          }
        }
      }
    },
    "@ws/app": {
      "projectType": "library",
      "root": "project/ws/app",
      "sourceRoot": "project/ws/app/src",
      "prefix": "ws-app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "project/ws/app/tsconfig.lib.json",
            "project": "project/ws/app/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "project/ws/app/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "project/ws/app/src/test.ts",
            "tsConfig": "project/ws/app/tsconfig.spec.json",
            "karmaConfig": "project/ws/app/karma.conf.js"
          }
        }
      }
    },
    "@ws/author": {
      "projectType": "library",
      "root": "project/ws/author",
      "sourceRoot": "project/ws/author/src",
      "prefix": "ws-author",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "project/ws/author/tsconfig.lib.json",
            "project": "project/ws/author/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "project/ws/author/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "project/ws/author/src/test.ts",
            "tsConfig": "project/ws/author/tsconfig.spec.json",
            "karmaConfig": "project/ws/author/karma.conf.js"
          }
        }
      }
    },
    "@ws/analytics": {
      "projectType": "library",
      "root": "project/ws/analytics",
      "sourceRoot": "project/ws/analytics/src",
      "prefix": "ws-analytics",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "project/ws/analytics/tsconfig.lib.json",
            "project": "project/ws/analytics/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "project/ws/analytics/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "project/ws/analytics/src/test.ts",
            "tsConfig": "project/ws/analytics/tsconfig.spec.json",
            "karmaConfig": "project/ws/analytics/karma.conf.js"
          }
        }
      }
    },
    "@ws/viewer": {
      "projectType": "library",
      "root": "project/ws/viewer",
      "sourceRoot": "project/ws/viewer/src",
      "prefix": "viewer",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "project/ws/viewer/tsconfig.lib.json",
            "project": "project/ws/viewer/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "project/ws/viewer/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "project/ws/viewer/src/test.ts",
            "tsConfig": "project/ws/viewer/tsconfig.spec.json",
            "karmaConfig": "project/ws/viewer/karma.conf.js"
          }
        }
      }
    },
    "@ws-widget/collection": {
      "projectType": "library",
      "root": "library/ws-widget/collection",
      "sourceRoot": "library/ws-widget/collection/src",
      "prefix": "ws-widget",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "library/ws-widget/collection/tsconfig.lib.json",
            "project": "library/ws-widget/collection/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "library/ws-widget/collection/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "library/ws-widget/collection/src/test.ts",
            "tsConfig": "library/ws-widget/collection/tsconfig.spec.json",
            "karmaConfig": "library/ws-widget/collection/karma.conf.js"
          }
        }
      }
    },
    "@ws-widget/resolver": {
      "projectType": "library",
      "root": "library/ws-widget/resolver",
      "sourceRoot": "library/ws-widget/resolver/src",
      "prefix": "ws-resolver",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "tsConfig": "library/ws-widget/resolver/tsconfig.lib.json",
            "project": "library/ws-widget/resolver/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "library/ws-widget/resolver/tsconfig.lib.prod.json"
            }
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "library/ws-widget/resolver/src/test.ts",
            "tsConfig": "library/ws-widget/resolver/tsconfig.spec.json",
            "karmaConfig": "library/ws-widget/resolver/karma.conf.js"
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": "0960077c-cd40-4a38-a76c-e63878df5326",
    "cache": {
      "enabled": true,
      "environment": "all",
      "path": ".angular/cache"
    }
  }
}
